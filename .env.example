# ============================================================
# Inverse Student Simulation — example environment file
# Copy to .env and fill in real values. .env is gitignored.
# ============================================================

# --- OpenAI (silver labeling: label_latent_z_openai.py / v2 / v3;
#     E5/E7 API baselines) ---
OPENAI_API_KEY=

# --- OpenRouter (optional unified gateway; used if OPENROUTER_BASE_URL is set) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERRER=https://github.com/YOUR_USERNAME/inverse-student-simulation-repro
OPENROUTER_X_TITLE=Inverse Student Simulation

# --- Hugging Face (Qwen2.5-3B-Instruct + MathDial/Bridge dataset download) ---
HF_TOKEN=

# --- Weights & Biases (optional training logging; defaults to offline) ---
WANDB_API_KEY=
WANDB_PROJECT=inverse-student-sim
WANDB_ENTITY=
WANDB_MODE=offline

# --- Caching ---
TRANSFORMERS_CACHE=./.hf_cache
HF_DATASETS_CACHE=./.hf_cache/datasets

# --- Reproducibility ---
ISS_SEED=42
